# ──────────────────────────────────────────────
# DsSync Hub — Frontend Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and replace all values

# Backend API URL (local or production)
VITE_API_URL=http://localhost:5000/api

# Application name (used in UI)
VITE_APP_NAME=DsSync Hub

# Google OAuth Client ID (must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Razorpay Key ID (must match backend RAZORPAY_KEY_ID)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Optional: Environment label
# VITE_ENV=development

# Sentry error monitoring (frontend)
# VITE_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
