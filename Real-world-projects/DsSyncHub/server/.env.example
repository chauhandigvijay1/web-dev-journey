# ──────────────────────────────────────────────
# DsSync Hub — Backend Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and replace all values

# Server
PORT=5000
NODE_ENV=development
# LOG_LEVEL=debug              # pino log level: debug|info|warn|error|fatal (default: info)

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/dssyncdb?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-64-char-random-hex-secret
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173
# Optional: comma-separated additional origins
CLIENT_ORIGINS=

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Email (Nodemailer)
# Option A — Gmail App Password: https://myaccount.google.com/apppasswords
#   Just set EMAIL_USER, EMAIL_PASS, EMAIL_FROM (leave EMAIL_HOST/EMAIL_PORT empty)
# Option B — SendGrid: EMAIL_HOST=smtp.sendgrid.net / EMAIL_PORT=587 / EMAIL_USER=apikey
# Option C — Resend (free tier, works on Render, no DNS setup):
#   EMAIL_HOST=smtp.resend.com
#   EMAIL_PORT=465
#   EMAIL_USER=resend
#   EMAIL_PASS=<your-resend-api-key>
#   EMAIL_FROM=onboarding@resend.dev
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-gmail-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_HOST=
EMAIL_PORT=

# Razorpay (Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-test-secret

# Billing provider (razorpay / stripe / none)
BILLING_PROVIDER=razorpay

# Billing webhook secret (for verifying payment webhooks)
BILLING_WEBHOOK_SECRET=your-webhook-secret

# AI — Groq API (supports comma-separated keys for fallback)
GROQ_API_KEY=gsk_your_groq_api_key

# Optional: Resend (alternative email provider)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Billing currency (ISO 4217)
BILLING_CURRENCY=INR

# Optional: Owner coupon code (for free Pro access)
# OWNER_COUPON_CODE=YOUR_SECRET_CODE

# Sentry error monitoring
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Cloudinary (cloud file storage — alt to local uploads/)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=your-api-secret

# Redis (for distributed rate limiting + socket adapter)
# REDIS_URL=redis://default:password@host:6379
